    "cmake.sourceDirectory": "${workspaceFolder}/babyduck",
    "cmake.buildDirectory": "${workspaceFolder}/babyduck/build",
    "cmake.configureSettings": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
