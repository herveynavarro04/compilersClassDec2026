program recursion;
var i : int;
int fact(n : int) [
  {
    if (n < 2) {
      return 1;
    } else {
      return n * fact(n - 1);
    };
  }
];
int fib(n : int) [
  {
    if (n < 2) {
      return n;
    } else {
      return fib(n - 1) + fib(n - 2);
    };
  }
];
main {
  i = 0;
  while (i < 6) do {
    print("fact(", i, ")=", fact(i));
    i = i + 1;
  };
  i = 0;
  while (i < 7) do {
    print("fib(", i, ")=", fib(i));
    i = i + 1;
  };
}
end
